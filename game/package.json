{
  "name": "knotz-bizarre-escape",
  "private": true,
  "version": "0.1.0",
  "description": "Knotz Bizarre Escape - a Phaser 4 run-and-gun",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --port 4173",
    "typecheck": "tsc --noEmit",
    "check:phaser4": "node tools/check-phaser4.mjs",
    "art": "bash tools/build-art.sh",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  }
}
